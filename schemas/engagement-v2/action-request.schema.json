{
  "$defs": {
    "digest": {
      "maxLength": 71,
      "minLength": 71,
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string",
      "x-hackbot-max-utf8-bytes": 71
    },
    "identifier": {
      "maxLength": 128,
      "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
      "type": "string",
      "x-hackbot-max-utf8-bytes": 128
    },
    "parameter_value": {
      "oneOf": [
        {
          "maxLength": 8192,
          "type": "string",
          "x-hackbot-max-utf8-bytes": 8192
        },
        {
          "maximum": 9223372036854775807,
          "minimum": -9223372036854775808,
          "type": "integer"
        },
        {
          "type": "boolean"
        },
        {
          "$ref": "#/$defs/target_list"
        }
      ]
    },
    "risk_level": {
      "enum": [
        "L0",
        "L1",
        "L2",
        "L3"
      ],
      "type": "string"
    },
    "strict_boolean": {
      "type": "boolean"
    },
    "target": {
      "maxLength": 2048,
      "minLength": 1,
      "type": "string",
      "x-hackbot-max-utf8-bytes": 2048
    },
    "target_list": {
      "items": {
        "$ref": "#/$defs/target"
      },
      "maxItems": 65536,
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    }
  },
  "$id": "urn:hackbot:schema:engagement-v2:action-request:2",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "action_id": {
      "$ref": "#/$defs/identifier"
    },
    "cleanup_plan": {
      "maxLength": 8192,
      "minLength": 1,
      "type": "string",
      "x-hackbot-max-utf8-bytes": 8192
    },
    "expected_impact": {
      "maxLength": 8192,
      "minLength": 1,
      "type": "string",
      "x-hackbot-max-utf8-bytes": 8192
    },
    "hypothesis_id": {
      "$ref": "#/$defs/identifier"
    },
    "parameters": {
      "additionalProperties": false,
      "maxProperties": 128,
      "patternProperties": {
        "^[a-z][a-z0-9_]{0,63}$": {
          "$ref": "#/$defs/parameter_value"
        }
      },
      "type": "object"
    },
    "rationale": {
      "maxLength": 8192,
      "minLength": 1,
      "type": "string",
      "x-hackbot-max-utf8-bytes": 8192
    },
    "requested_risk": {
      "$ref": "#/$defs/risk_level"
    },
    "schema_version": {
      "const": 2,
      "type": "integer"
    },
    "stop_condition": {
      "maxLength": 8192,
      "minLength": 1,
      "type": "string",
      "x-hackbot-max-utf8-bytes": 8192
    }
  },
  "required": [
    "schema_version",
    "action_id",
    "parameters",
    "hypothesis_id",
    "rationale",
    "expected_impact",
    "stop_condition",
    "cleanup_plan"
  ],
  "type": "object",
  "x-hackbot-max-document-nesting-depth": 32
}
